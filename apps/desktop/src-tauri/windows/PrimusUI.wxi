<?xml version="1.0" encoding="utf-8"?>
<!--
  MSI 直接安装时的界面 PrimusUI（ADR 0012、0014），由 Primus.wxs 以 <?include PrimusUI.wxi ?> 收入。
  与 exe 安装程序的界面（setup-theme.xml + bundle-zh-CN.wxl）是同一套设计，页面、文案（逐字）、按钮位置一一对应，共 6 步：

    1 欢迎 → 2 隐私政策 → 3 选择安装位置（“安装”）→ 4 UAC → 5 正在安装（进度条）→ 6 安装完成（立即启动 / 完成）
    | 安装未完成 | 已取消
    已安装时再次运行：乾元 Primus 已安装（修复 / 卸载）→ 进度 → 完成

  - 前三步是同一个对话框 PrimusInstallDlg：属性 PRIMUS_STEP（1～3）+ “上一步 / 下一步”的 Publish Property 切换，
    各控件用 ShowCondition / HideCondition / EnableCondition / DisableCondition 显隐，不用 NewDialog（不销毁、不重建窗口）。
    “下一步”在第 2 步的启用条件是 PRIMUS_AGREE（“我已阅读并同意隐私政策”）。“安装”只在第 3 步出现，带 ElevationShield；
    点“安装”后 Windows Installer 才在执行阶段请求管理员权限（UI 序列不提权）。
    “下一步 / 上一步”的两条 Publish 按“先判断大的步骤”排列：MSI 逐条求值条件，前一条改了 PRIMUS_STEP 后一条不会再命中。
  - 白底：每个对话框第一个控件是整页白色位图（msi-white.bmp），文字控件 Transparent；分割线 / 边框用 #e1e1e3 位图
    （msi-line.bmp），不用 Line 控件（立体刻线）。MSI 的复选框不能透明（会露出系统灰底），所以同意复选框只画方框，
    文字是旁边的透明文字控件（点文字不切换勾选，用鼠标点方框或 Tab 到方框后按空格；ADR 0014）。
    MSI 的 Text 不能居中，欢迎页与完成页的居中文字按估算宽度摆放（Microsoft YaHei UI）。
  - 尺寸：对话框 416×304 安装单位（1 单位约 1.33 像素，约 555×405 像素，与 exe 窗口一致）；坐标按效果图像素 ×0.75。
  - 减少闪烁：
    - 安装前只有一个对话框；不显示 PrepareDlg；三步之间只显隐控件。
    - 进度页不订阅 ActionText / ActionData（安装中每个动作都会改这行字，透明文字反复重绘就是闪烁），只有进度条与一行固定说明；
      进度条用平滑样式（不用 ProgressBlocks）。
    - 所有对话框标题栏文字相同（“乾元 Primus 安装程序”），切换页面时任务栏与标题不跳。
    - 按模式变化的标题用互斥的 ShowCondition，在对话框创建时一次定好。
  - 字体统一为 Microsoft YaHei UI（Tahoma 没有中文字形）；正文 #1d1d1f，次要文字 #6e6e73。按钮、复选框、进度条、
    滚动条用系统样式（MSI 不能做黑底白字按钮，exe 也用系统按钮保持一致）。
  经 exe 安装时（Bundle.wxs）MSI 不显示这些界面，由 exe 自己画同样的页面。
-->
<Include xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- 安装位置控件编辑的目录属性（BrowseDlg 等 WixUI 公共对话框沿用这个名字） -->
  <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
  <!-- 安装目录装好后不能“更改”；修复、卸载照常（原来由 WixUI_InstallDir 提供） -->
  <Property Id="ARPNOMODIFY" Value="1" />
  <!-- 安装向导的当前步骤（1 欢迎、2 隐私政策、3 选择安装位置） -->
  <Property Id="PRIMUS_STEP" Value="1" />
  <!-- 已装过 MSI 版、或要从旧 NSIS 版迁移：沿用原目录，界面上不能改（与 exe 的 PrimusFolderLocked 一致） -->
  <SetProperty Id="PRIMUS_FOLDER_LOCKED" Value="1" After="AppSearch" Sequence="ui"
               Condition="PREVIOUS_INSTALLFOLDER OR (NSIS_UNINSTALLER AND NSIS_INSTALLDIR)" />

  <!-- 界面图片（scripts/render-installer-art.py 生成，24 位 BMP） -->
  <Binary Id="PrimusBmpWhite" SourceFile="$(ShellDir)\windows\art\msi-white.bmp" />
  <Binary Id="PrimusBmpLine" SourceFile="$(ShellDir)\windows\art\msi-line.bmp" />
  <Binary Id="PrimusBmpIcon40" SourceFile="$(ShellDir)\windows\art\msi-icon-40.bmp" />
  <Binary Id="PrimusBmpIcon72" SourceFile="$(ShellDir)\windows\art\msi-icon-72.bmp" />
  <Binary Id="PrimusBmpCheck" SourceFile="$(ShellDir)\windows\art\msi-check-44.bmp" />
  <Binary Id="PrimusBmpSteps1" SourceFile="$(ShellDir)\windows\art\msi-steps-1.bmp" />
  <Binary Id="PrimusBmpSteps2" SourceFile="$(ShellDir)\windows\art\msi-steps-2.bmp" />
  <Binary Id="PrimusBmpSteps3" SourceFile="$(ShellDir)\windows\art\msi-steps-3.bmp" />

  <UI Id="PrimusUI">
    <TextStyle Id="Primus_Font_Normal" FaceName="Microsoft YaHei UI" Size="10" Red="29" Green="29" Blue="31" />
    <TextStyle Id="Primus_Font_Title" FaceName="Microsoft YaHei UI" Size="12" Bold="yes" Red="29" Green="29" Blue="31" />
    <TextStyle Id="Primus_Font_Hero" FaceName="Microsoft YaHei UI" Size="13" Bold="yes" Red="29" Green="29" Blue="31" />
    <TextStyle Id="Primus_Font_Muted" FaceName="Microsoft YaHei UI" Size="9" Red="110" Green="110" Blue="115" />
    <TextStyle Id="Primus_Font_Small" FaceName="Microsoft YaHei UI" Size="8" Red="110" Green="110" Blue="115" />
    <!-- WixUI 公共对话框（浏览、取消确认、磁盘空间、文件占用、错误）引用的字体名 -->
    <TextStyle Id="WixUI_Font_Normal" FaceName="Microsoft YaHei UI" Size="9" />
    <TextStyle Id="WixUI_Font_Bigger" FaceName="Microsoft YaHei UI" Size="12" />
    <TextStyle Id="WixUI_Font_Title" FaceName="Microsoft YaHei UI" Size="9" Bold="yes" />
    <Property Id="DefaultUIFont" Value="Primus_Font_Normal" />

    <DialogRef Id="BrowseDlg" />
    <DialogRef Id="CancelDlg" />
    <DialogRef Id="DiskCostDlg" />
    <DialogRef Id="ErrorDlg" />
    <DialogRef Id="FilesInUse" />
    <DialogRef Id="MsiRMFilesInUse" />
    <DialogRef Id="OutOfDiskDlg" />
    <DialogRef Id="OutOfRbDiskDlg" />
    <DialogRef Id="WaitForCostingDlg" />

    <!-- 浏览安装目录（WixUI 的 BrowseDlg） -->
    <Publish Dialog="BrowseDlg" Control="OK" Event="CheckTargetPath" Value="[_BrowseProperty]" Order="1" />
    <Publish Dialog="BrowseDlg" Control="OK" Event="SetTargetPath" Value="[_BrowseProperty]" Order="3" />
    <Publish Dialog="BrowseDlg" Control="OK" Event="EndDialog" Value="Return" Order="4" />

    <!-- 安装向导 1～3 步：与 exe 的 Install 页相同（同一个对话框里按 PRIMUS_STEP 显隐） -->
    <Dialog Id="PrimusInstallDlg" Width="416" Height="304" Title="乾元 Primus 安装程序" TrackDiskSpace="yes">
      <Control Id="Background" Type="Bitmap" X="0" Y="0" Width="416" Height="304" TabSkip="no" Disabled="yes" Text="PrimusBmpWhite" />

      <!-- 右上角步骤指示：圆点 + n/3 -->
      <Control Id="Steps1" Type="Bitmap" X="344" Y="25" Width="30" Height="5" TabSkip="no" Disabled="yes" Hidden="yes" Text="PrimusBmpSteps1" ShowCondition="PRIMUS_STEP = &quot;1&quot;" HideCondition="PRIMUS_STEP &lt;&gt; &quot;1&quot;" />
      <Control Id="Steps2" Type="Bitmap" X="344" Y="25" Width="30" Height="5" TabSkip="no" Disabled="yes" Hidden="yes" Text="PrimusBmpSteps2" ShowCondition="PRIMUS_STEP = &quot;2&quot;" HideCondition="PRIMUS_STEP &lt;&gt; &quot;2&quot;" />
      <Control Id="Steps3" Type="Bitmap" X="344" Y="25" Width="30" Height="5" TabSkip="no" Disabled="yes" Hidden="yes" Text="PrimusBmpSteps3" ShowCondition="PRIMUS_STEP = &quot;3&quot;" HideCondition="PRIMUS_STEP &lt;&gt; &quot;3&quot;" />
      <Control Id="Step1Count" Type="Text" X="377" Y="20" Width="18" Height="12" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="{\Primus_Font_Small}1/3" ShowCondition="PRIMUS_STEP = &quot;1&quot;" HideCondition="PRIMUS_STEP &lt;&gt; &quot;1&quot;" />
      <Control Id="Step2Count" Type="Text" X="377" Y="20" Width="18" Height="12" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="{\Primus_Font_Small}2/3" ShowCondition="PRIMUS_STEP = &quot;2&quot;" HideCondition="PRIMUS_STEP &lt;&gt; &quot;2&quot;" />
      <Control Id="Step3Count" Type="Text" X="377" Y="20" Width="18" Height="12" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="{\Primus_Font_Small}3/3" ShowCondition="PRIMUS_STEP = &quot;3&quot;" HideCondition="PRIMUS_STEP &lt;&gt; &quot;3&quot;" />

      <!-- 1 欢迎（MSI 的 Text 不能居中，按估算宽度摆放） -->
      <Control Id="WelcomeIcon" Type="Bitmap" X="181" Y="42" Width="54" Height="54" TabSkip="no" Disabled="yes" Hidden="yes" Text="PrimusBmpIcon72" ShowCondition="PRIMUS_STEP = &quot;1&quot;" HideCondition="PRIMUS_STEP &lt;&gt; &quot;1&quot;" />
      <Control Id="WelcomeTitle" Type="Text" X="141" Y="108" Width="170" Height="20" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="{\Primus_Font_Hero}欢迎安装 乾元 Primus" ShowCondition="PRIMUS_STEP = &quot;1&quot;" HideCondition="PRIMUS_STEP &lt;&gt; &quot;1&quot;" />
      <Control Id="WelcomeVersion" Type="Text" X="187" Y="130" Width="160" Height="14" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="{\Primus_Font_Muted}版本 $(PrimusVersion)" ShowCondition="PRIMUS_STEP = &quot;1&quot;" HideCondition="PRIMUS_STEP &lt;&gt; &quot;1&quot;" />
      <Control Id="WelcomeText" Type="Text" X="108" Y="160" Width="230" Height="33" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="安装向导将在这台电脑上安装 乾元 Primus。&#13;&#10;单击“下一步”继续，或单击“取消”退出。" ShowCondition="PRIMUS_STEP = &quot;1&quot;" HideCondition="PRIMUS_STEP &lt;&gt; &quot;1&quot;" />

      <!-- 2、3 的页眉标志 -->
      <Control Id="HeaderIcon" Type="Bitmap" X="22" Y="16" Width="30" Height="30" TabSkip="no" Disabled="yes" Hidden="yes" Text="PrimusBmpIcon40" ShowCondition="PRIMUS_STEP &lt;&gt; &quot;1&quot;" HideCondition="PRIMUS_STEP = &quot;1&quot;" />

      <!-- 2 隐私政策：#e1e1e3 边框（四条位图）+ 无边框的 Privacy.rtf + 同意 -->
      <Control Id="PrivacyTitle" Type="Text" X="63" Y="16" Width="270" Height="18" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="{\Primus_Font_Title}隐私政策" ShowCondition="PRIMUS_STEP = &quot;2&quot;" HideCondition="PRIMUS_STEP &lt;&gt; &quot;2&quot;" />
      <Control Id="PrivacySubtitle" Type="Text" X="63" Y="34" Width="270" Height="14" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="{\Primus_Font_Muted}安装前请阅读并同意隐私政策" ShowCondition="PRIMUS_STEP = &quot;2&quot;" HideCondition="PRIMUS_STEP &lt;&gt; &quot;2&quot;" />
      <Control Id="PrivacyBorderTop" Type="Bitmap" X="22" Y="57" Width="372" Height="1" TabSkip="no" Disabled="yes" Hidden="yes" Text="PrimusBmpLine" ShowCondition="PRIMUS_STEP = &quot;2&quot;" HideCondition="PRIMUS_STEP &lt;&gt; &quot;2&quot;" />
      <Control Id="PrivacyBorderBottom" Type="Bitmap" X="22" Y="191" Width="372" Height="1" TabSkip="no" Disabled="yes" Hidden="yes" Text="PrimusBmpLine" ShowCondition="PRIMUS_STEP = &quot;2&quot;" HideCondition="PRIMUS_STEP &lt;&gt; &quot;2&quot;" />
      <Control Id="PrivacyBorderLeft" Type="Bitmap" X="22" Y="57" Width="1" Height="135" TabSkip="no" Disabled="yes" Hidden="yes" Text="PrimusBmpLine" ShowCondition="PRIMUS_STEP = &quot;2&quot;" HideCondition="PRIMUS_STEP &lt;&gt; &quot;2&quot;" />
      <Control Id="PrivacyBorderRight" Type="Bitmap" X="393" Y="57" Width="1" Height="135" TabSkip="no" Disabled="yes" Hidden="yes" Text="PrimusBmpLine" ShowCondition="PRIMUS_STEP = &quot;2&quot;" HideCondition="PRIMUS_STEP &lt;&gt; &quot;2&quot;" />
      <Control Id="Privacy" Type="ScrollableText" X="23" Y="58" Width="370" Height="133" TabSkip="no" Hidden="yes" ShowCondition="PRIMUS_STEP = &quot;2&quot;" HideCondition="PRIMUS_STEP &lt;&gt; &quot;2&quot;">
        <Text SourceFile="$(ShellDir)\windows\Privacy.rtf" />
      </Control>
      <Control Id="Agree" Type="CheckBox" X="22" Y="202" Width="11" Height="11" Property="PRIMUS_AGREE" CheckBoxValue="1" Hidden="yes" Text="我已阅读并同意隐私政策(&amp;A)" ShowCondition="PRIMUS_STEP = &quot;2&quot;" HideCondition="PRIMUS_STEP &lt;&gt; &quot;2&quot;" />
      <Control Id="AgreeLabel" Type="Text" X="37" Y="201" Width="350" Height="15" Transparent="yes" Hidden="yes" Text="我已阅读并同意隐私政策(&amp;A)" ShowCondition="PRIMUS_STEP = &quot;2&quot;" HideCondition="PRIMUS_STEP &lt;&gt; &quot;2&quot;" />

      <!-- 3 选择安装位置：已安装 / 从 NSIS 迁移时目录锁定并显示说明 -->
      <Control Id="FolderTitle" Type="Text" X="63" Y="16" Width="270" Height="18" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="{\Primus_Font_Title}选择安装位置" ShowCondition="PRIMUS_STEP = &quot;3&quot;" HideCondition="PRIMUS_STEP &lt;&gt; &quot;3&quot;" />
      <Control Id="FolderSubtitle" Type="Text" X="63" Y="34" Width="270" Height="14" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="{\Primus_Font_Muted}乾元 Primus 将安装到下面的文件夹" ShowCondition="PRIMUS_STEP = &quot;3&quot;" HideCondition="PRIMUS_STEP &lt;&gt; &quot;3&quot;" />
      <Control Id="FolderLabel" Type="Text" X="22" Y="69" Width="50" Height="15" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="安装位置" ShowCondition="PRIMUS_STEP = &quot;3&quot;" HideCondition="PRIMUS_STEP &lt;&gt; &quot;3&quot;" />
      <Control Id="FolderLocked" Type="Text" X="72" Y="70" Width="322" Height="14" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="{\Primus_Font_Muted}已安装过：将升级到此版本，沿用原安装位置与数据" ShowCondition="PRIMUS_STEP = &quot;3&quot; AND PRIMUS_FOLDER_LOCKED" HideCondition="PRIMUS_STEP &lt;&gt; &quot;3&quot; OR NOT PRIMUS_FOLDER_LOCKED" />
      <Control Id="Folder" Type="PathEdit" X="22" Y="91" Width="300" Height="20" Property="WIXUI_INSTALLDIR" Indirect="yes" Hidden="yes" ShowCondition="PRIMUS_STEP = &quot;3&quot;" HideCondition="PRIMUS_STEP &lt;&gt; &quot;3&quot;" DisableCondition="PRIMUS_FOLDER_LOCKED" />
      <Control Id="ChangeFolder" Type="PushButton" X="328" Y="90" Width="66" Height="22" Hidden="yes" Text="更改(&amp;C)..." ShowCondition="PRIMUS_STEP = &quot;3&quot;" HideCondition="PRIMUS_STEP &lt;&gt; &quot;3&quot;" DisableCondition="PRIMUS_FOLDER_LOCKED">
        <Publish Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1" />
        <Publish Event="SpawnDialog" Value="BrowseDlg" Order="2" />
      </Control>
      <Control Id="FolderNote" Type="Text" X="22" Y="120" Width="372" Height="30" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="{\Primus_Font_Muted}会话记录等数据保存在安装目录的 data 文件夹中，卸载时默认保留。&#13;&#10;单击“安装”后，Windows 会请求管理员权限。" ShowCondition="PRIMUS_STEP = &quot;3&quot;" HideCondition="PRIMUS_STEP &lt;&gt; &quot;3&quot;" />

      <!-- 底部按钮：上一步（2、3）· 下一步（1、2）/ 安装（3，只在这一步）· 取消 -->
      <Control Id="BottomLine" Type="Bitmap" X="0" Y="262" Width="416" Height="1" TabSkip="no" Disabled="yes" Text="PrimusBmpLine" />
      <Control Id="Back" Type="PushButton" X="196" Y="271" Width="66" Height="22" Hidden="yes" Text="上一步(&amp;B)" ShowCondition="PRIMUS_STEP &lt;&gt; &quot;1&quot;" HideCondition="PRIMUS_STEP = &quot;1&quot;">
        <Publish Property="PRIMUS_STEP" Value="1" Order="1" Condition="PRIMUS_STEP = &quot;2&quot;" />
        <Publish Property="PRIMUS_STEP" Value="2" Order="2" Condition="PRIMUS_STEP = &quot;3&quot;" />
      </Control>
      <Control Id="Next" Type="PushButton" X="268" Y="271" Width="66" Height="22" Default="yes" Text="下一步(&amp;N)" ShowCondition="PRIMUS_STEP &lt;&gt; &quot;3&quot;" HideCondition="PRIMUS_STEP = &quot;3&quot;" EnableCondition="PRIMUS_STEP = &quot;1&quot; OR PRIMUS_AGREE = &quot;1&quot;" DisableCondition="PRIMUS_STEP = &quot;2&quot; AND PRIMUS_AGREE &lt;&gt; &quot;1&quot;" DefaultCondition="PRIMUS_STEP &lt;&gt; &quot;3&quot;">
        <Publish Property="PRIMUS_STEP" Value="3" Order="1" Condition="PRIMUS_STEP = &quot;2&quot; AND PRIMUS_AGREE = &quot;1&quot;" />
        <Publish Property="PRIMUS_STEP" Value="2" Order="2" Condition="PRIMUS_STEP = &quot;1&quot;" />
      </Control>
      <Control Id="Install" Type="PushButton" ElevationShield="yes" X="268" Y="271" Width="66" Height="22" Hidden="yes" Disabled="yes" Text="安装(&amp;I)" ShowCondition="PRIMUS_STEP = &quot;3&quot;" HideCondition="PRIMUS_STEP &lt;&gt; &quot;3&quot;" EnableCondition="PRIMUS_STEP = &quot;3&quot; AND PRIMUS_AGREE = &quot;1&quot;" DisableCondition="PRIMUS_STEP &lt;&gt; &quot;3&quot; OR PRIMUS_AGREE &lt;&gt; &quot;1&quot;" DefaultCondition="PRIMUS_STEP = &quot;3&quot;">
        <Publish Event="CheckTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1" Condition="PRIMUS_STEP = &quot;3&quot; AND PRIMUS_AGREE = &quot;1&quot;" />
        <Publish Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="2" Condition="PRIMUS_STEP = &quot;3&quot; AND PRIMUS_AGREE = &quot;1&quot;" />
        <Publish Event="SpawnWaitDialog" Value="WaitForCostingDlg" Order="3" Condition="!(wix.WixUICostingPopupOptOut) OR CostingComplete = 1" />
        <Publish Event="EndDialog" Value="Return" Order="4" Condition="PRIMUS_STEP = &quot;3&quot; AND PRIMUS_AGREE = &quot;1&quot; AND OutOfDiskSpace &lt;&gt; 1" />
        <Publish Event="SpawnDialog" Value="OutOfRbDiskDlg" Order="5" Condition="OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND (PROMPTROLLBACKCOST=&quot;P&quot; OR NOT PROMPTROLLBACKCOST)" />
        <Publish Event="EndDialog" Value="Return" Order="6" Condition="PRIMUS_STEP = &quot;3&quot; AND PRIMUS_AGREE = &quot;1&quot; AND OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND PROMPTROLLBACKCOST=&quot;D&quot;" />
        <Publish Event="EnableRollback" Value="False" Order="7" Condition="OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND PROMPTROLLBACKCOST=&quot;D&quot;" />
        <Publish Event="SpawnDialog" Value="OutOfDiskDlg" Order="8" Condition="(OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 1) OR (OutOfDiskSpace = 1 AND PROMPTROLLBACKCOST=&quot;F&quot;)" />
      </Control>
      <Control Id="Cancel" Type="PushButton" X="340" Y="271" Width="66" Height="22" Cancel="yes" Text="取消">
        <Publish Event="SpawnDialog" Value="CancelDlg" />
      </Control>
    </Dialog>

    <!-- 已安装时再次运行这个 MSI：修复或卸载（从“应用和功能”卸载走 Windows 自己的简易界面，不经这里） -->
    <Dialog Id="PrimusMaintenanceDlg" Width="416" Height="304" Title="乾元 Primus 安装程序">
      <Control Id="Background" Type="Bitmap" X="0" Y="0" Width="416" Height="304" TabSkip="no" Disabled="yes" Text="PrimusBmpWhite" />
      <Control Id="HeaderIcon" Type="Bitmap" X="22" Y="16" Width="30" Height="30" TabSkip="no" Disabled="yes" Text="PrimusBmpIcon40" />
      <Control Id="Title" Type="Text" X="63" Y="16" Width="270" Height="18" Transparent="yes" NoPrefix="yes" Text="{\Primus_Font_Title}乾元 Primus 已安装" />
      <Control Id="Version" Type="Text" X="63" Y="34" Width="270" Height="14" Transparent="yes" NoPrefix="yes" Text="{\Primus_Font_Muted}版本 $(PrimusVersion)" />
      <Control Id="Text" Type="Text" X="22" Y="72" Width="372" Height="45" Transparent="yes" NoPrefix="yes" Text="这台电脑上已经安装了这个版本。可以修复（重新写入程序文件），或从这台电脑卸载；卸载会保留安装目录下的 data。" />
      <Control Id="BottomLine" Type="Bitmap" X="0" Y="262" Width="416" Height="1" TabSkip="no" Disabled="yes" Text="PrimusBmpLine" />
      <Control Id="Repair" Type="PushButton" ElevationShield="yes" X="196" Y="271" Width="66" Height="22" Text="修复(&amp;R)">
        <Publish Property="PRIMUS_MODE" Value="Repair" Order="1" />
        <Publish Event="ReinstallMode" Value="ecmus" Order="2" />
        <Publish Event="Reinstall" Value="ALL" Order="3" />
        <Publish Event="EndDialog" Value="Return" Order="4" />
      </Control>
      <Control Id="Remove" Type="PushButton" ElevationShield="yes" X="268" Y="271" Width="66" Height="22" Text="卸载(&amp;U)">
        <Publish Property="PRIMUS_MODE" Value="Remove" Order="1" />
        <Publish Event="Remove" Value="ALL" Order="2" />
        <Publish Event="EndDialog" Value="Return" Order="3" />
      </Control>
      <Control Id="Cancel" Type="PushButton" X="340" Y="271" Width="66" Height="22" Default="yes" Cancel="yes" Text="取消">
        <Publish Event="SpawnDialog" Value="CancelDlg" />
      </Control>
    </Dialog>

    <!-- 5 正在安装：与 exe 的 Progress 页相同。不订阅 ActionText / ActionData，避免安装中整行文字反复重绘 -->
    <Dialog Id="PrimusProgressDlg" Width="416" Height="304" Title="乾元 Primus 安装程序" Modeless="yes">
      <Control Id="Background" Type="Bitmap" X="0" Y="0" Width="416" Height="304" TabSkip="no" Disabled="yes" Text="PrimusBmpWhite" />
      <Control Id="HeaderIcon" Type="Bitmap" X="22" Y="16" Width="30" Height="30" TabSkip="no" Disabled="yes" Text="PrimusBmpIcon40" />
      <Control Id="TitleInstalling" Type="Text" X="63" Y="16" Width="270" Height="18" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="{\Primus_Font_Title}正在安装 乾元 Primus" ShowCondition="NOT PRIMUS_MODE" />
      <Control Id="TitleRepairing" Type="Text" X="63" Y="16" Width="270" Height="18" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="{\Primus_Font_Title}正在修复 乾元 Primus" ShowCondition="PRIMUS_MODE = &quot;Repair&quot;" />
      <Control Id="TitleRemoving" Type="Text" X="63" Y="16" Width="270" Height="18" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="{\Primus_Font_Title}正在卸载 乾元 Primus" ShowCondition="PRIMUS_MODE = &quot;Remove&quot;" />
      <Control Id="Version" Type="Text" X="63" Y="34" Width="270" Height="14" Transparent="yes" NoPrefix="yes" Text="{\Primus_Font_Muted}版本 $(PrimusVersion)" />
      <Control Id="Text" Type="Text" X="22" Y="81" Width="372" Height="15" Transparent="yes" NoPrefix="yes" Text="请稍候，这通常不到一分钟。" />
      <Control Id="ProgressBar" Type="ProgressBar" X="22" Y="106" Width="372" Height="10" Text="进度">
        <Subscribe Event="SetProgress" Attribute="Progress" />
      </Control>
      <Control Id="BottomLine" Type="Bitmap" X="0" Y="262" Width="416" Height="1" TabSkip="no" Disabled="yes" Text="PrimusBmpLine" />
      <Control Id="Cancel" Type="PushButton" X="340" Y="271" Width="66" Height="22" Default="yes" Cancel="yes" Text="取消">
        <Publish Event="SpawnDialog" Value="CancelDlg" />
      </Control>
    </Dialog>

    <!-- 6 安装完成：与 exe 的 Success 页相同（立即启动 / 完成）。立即启动用 WixShellExec 在界面进程（安装者本人、未提权）中运行 -->
    <Dialog Id="PrimusExitDlg" Width="416" Height="304" Title="乾元 Primus 安装程序">
      <Control Id="Background" Type="Bitmap" X="0" Y="0" Width="416" Height="304" TabSkip="no" Disabled="yes" Text="PrimusBmpWhite" />
      <Control Id="SuccessIcon" Type="Bitmap" X="192" Y="42" Width="33" Height="33" TabSkip="no" Disabled="yes" Text="PrimusBmpCheck" />
      <Control Id="TitleInstalled" Type="Text" X="181" Y="87" Width="100" Height="20" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="{\Primus_Font_Hero}安装完成" ShowCondition="NOT PRIMUS_MODE" />
      <Control Id="TitleRepaired" Type="Text" X="181" Y="87" Width="100" Height="20" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="{\Primus_Font_Hero}修复完成" ShowCondition="PRIMUS_MODE = &quot;Repair&quot;" />
      <Control Id="TitleRemoved" Type="Text" X="181" Y="87" Width="100" Height="20" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="{\Primus_Font_Hero}卸载完成" ShowCondition="PRIMUS_MODE = &quot;Remove&quot;" />
      <Control Id="Version" Type="Text" X="187" Y="110" Width="160" Height="14" Transparent="yes" NoPrefix="yes" Text="{\Primus_Font_Muted}版本 $(PrimusVersion)" />
      <Control Id="TextInstalled" Type="Text" X="83" Y="140" Width="300" Height="33" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="乾元 Primus 已安装完成，可以从开始菜单或桌面打开。" ShowCondition="PRIMUS_MODE &lt;&gt; &quot;Remove&quot;" />
      <Control Id="TextRemoved" Type="Text" X="50" Y="140" Width="350" Height="33" Transparent="yes" NoPrefix="yes" Hidden="yes" Text="乾元 Primus 已从这台电脑卸载，原有数据保留在安装目录的 data 中。" ShowCondition="PRIMUS_MODE = &quot;Remove&quot;" />
      <Control Id="BottomLine" Type="Bitmap" X="0" Y="262" Width="416" Height="1" TabSkip="no" Disabled="yes" Text="PrimusBmpLine" />
      <Control Id="Launch" Type="PushButton" X="268" Y="271" Width="66" Height="22" Hidden="yes" Text="立即启动(&amp;L)" ShowCondition="NOT Installed AND NOT PRIMUS_MODE AND NOT PRIMUS_BUNDLE">
        <Publish Event="DoAction" Value="LaunchPrimus" Order="1" />
        <Publish Event="EndDialog" Value="Return" Order="2" />
      </Control>
      <Control Id="Finish" Type="PushButton" X="340" Y="271" Width="66" Height="22" Default="yes" Cancel="yes" Text="完成(&amp;F)">
        <Publish Event="EndDialog" Value="Return" />
      </Control>
    </Dialog>

    <!-- 用户取消 -->
    <Dialog Id="PrimusUserExitDlg" Width="416" Height="304" Title="乾元 Primus 安装程序">
      <Control Id="Background" Type="Bitmap" X="0" Y="0" Width="416" Height="304" TabSkip="no" Disabled="yes" Text="PrimusBmpWhite" />
      <Control Id="HeaderIcon" Type="Bitmap" X="22" Y="16" Width="30" Height="30" TabSkip="no" Disabled="yes" Text="PrimusBmpIcon40" />
      <Control Id="Title" Type="Text" X="63" Y="16" Width="270" Height="18" Transparent="yes" NoPrefix="yes" Text="{\Primus_Font_Title}已取消" />
      <Control Id="Version" Type="Text" X="63" Y="34" Width="270" Height="14" Transparent="yes" NoPrefix="yes" Text="{\Primus_Font_Muted}版本 $(PrimusVersion)" />
      <Control Id="Text" Type="Text" X="22" Y="72" Width="372" Height="30" Transparent="yes" NoPrefix="yes" Text="安装没有完成。需要时可以再次运行安装程序。" />
      <Control Id="BottomLine" Type="Bitmap" X="0" Y="262" Width="416" Height="1" TabSkip="no" Disabled="yes" Text="PrimusBmpLine" />
      <Control Id="Finish" Type="PushButton" X="340" Y="271" Width="66" Height="22" Default="yes" Cancel="yes" Text="完成(&amp;F)">
        <Publish Event="EndDialog" Value="Exit" />
      </Control>
    </Dialog>

    <!-- 安装未完成：与 exe 的 Failure 页相同 -->
    <Dialog Id="PrimusFatalDlg" Width="416" Height="304" Title="乾元 Primus 安装程序">
      <Control Id="Background" Type="Bitmap" X="0" Y="0" Width="416" Height="304" TabSkip="no" Disabled="yes" Text="PrimusBmpWhite" />
      <Control Id="HeaderIcon" Type="Bitmap" X="22" Y="16" Width="30" Height="30" TabSkip="no" Disabled="yes" Text="PrimusBmpIcon40" />
      <Control Id="Title" Type="Text" X="63" Y="16" Width="270" Height="18" Transparent="yes" NoPrefix="yes" Text="{\Primus_Font_Title}安装未完成" />
      <Control Id="Version" Type="Text" X="63" Y="34" Width="270" Height="14" Transparent="yes" NoPrefix="yes" Text="{\Primus_Font_Muted}版本 $(PrimusVersion)" />
      <Control Id="Text" Type="Text" X="22" Y="72" Width="372" Height="60" Transparent="yes" NoPrefix="yes" Text="安装过程中出现错误，安装没有完成。可以重新运行安装程序；仍然失败时，请用命令 msiexec /i 安装包 /l*v install.log 生成安装日志后发给我们。" />
      <Control Id="BottomLine" Type="Bitmap" X="0" Y="262" Width="416" Height="1" TabSkip="no" Disabled="yes" Text="PrimusBmpLine" />
      <Control Id="Finish" Type="PushButton" X="340" Y="271" Width="66" Height="22" Default="yes" Cancel="yes" Text="完成(&amp;F)">
        <Publish Event="EndDialog" Value="Exit" />
      </Control>
    </Dialog>

    <InstallUISequence>
      <Show Dialog="PrimusInstallDlg" Before="PrimusProgressDlg" Condition="NOT Installed" />
      <Show Dialog="PrimusMaintenanceDlg" Before="PrimusProgressDlg" Condition="Installed AND NOT RESUME AND NOT PATCH" />
      <Show Dialog="PrimusProgressDlg" Before="ExecuteAction" />
      <Show Dialog="PrimusExitDlg" OnExit="success" />
      <Show Dialog="PrimusUserExitDlg" OnExit="cancel" />
      <Show Dialog="PrimusFatalDlg" OnExit="error" />
    </InstallUISequence>
    <AdminUISequence>
      <Show Dialog="PrimusProgressDlg" Before="ExecuteAction" />
      <Show Dialog="PrimusExitDlg" OnExit="success" />
      <Show Dialog="PrimusUserExitDlg" OnExit="cancel" />
      <Show Dialog="PrimusFatalDlg" OnExit="error" />
    </AdminUISequence>
  </UI>
  <UIRef Id="WixUI_Common" />
</Include>
